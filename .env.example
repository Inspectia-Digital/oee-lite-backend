# Copiar a .env y completar con valores reales. Nunca commitear .env con secretos.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://oeelite_user:oeelite_password@127.0.0.1:5432/oeelite_db
DATABASE_ECHO=false
AUTO_CREATE_TABLES=false

AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_JWKS_TIMEOUT_SECONDS=5

# Lista separada por comas, sin espacios extra. Nunca "*" en producción.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
